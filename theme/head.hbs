<!-- OpenGraph / social link previews (LinkedIn, X, Slack, iMessage …).
     Site-wide static card: scrapers do not run JS, so these must be plain
     meta tags. og:image must be an absolute URL — mdBook copies
     docs/og-card.png to the site root. -->
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ book_title }}">
<meta property="og:title" content="{{ book_title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="https://docs.navicore.tech/patch-prolog/">
<meta property="og:image" content="https://docs.navicore.tech/patch-prolog/og-card.png">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ book_title }}">
<meta name="twitter:description" content="{{ description }}">
<meta name="twitter:image" content="https://docs.navicore.tech/patch-prolog/og-card.png">
